{
  "name": "foot-draft",
  "private": true,
  "version": "0.1.0",
  "description": "FOOTBALL DRAFT - online football player draft & team building game",
  "workspaces": [
    "packages/*",
    "apps/*",
    "tools/*"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "dev:api": "npm run dev -w @fd/api",
    "dev:web": "npm run dev -w @fd/web",
    "dev:admin": "npm run dev -w @fd/admin",
    "db:migrate:local": "npm run db:migrate:local -w @fd/api",
    "seed:generate": "npm run seed:generate -w @fd/api",
    "admin:create:local": "npm run admin:create:local -w @fd/api",
    "sim:balance": "npm run sim:balance -w @fd/shared",
    "build": "npm run build --workspaces --if-present",
    "cards:appearance": "npm run appearance -w @fd/card-art",
    "cards:render": "npm run render -w @fd/card-art && python3 tools/card-art/optimize.py && npm run cards:photo",
    "cards:photo": "python3 tools/card-art/photo_cards.py"
  },
  "engines": {
    "node": ">=20"
  }
}
